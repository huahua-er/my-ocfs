# ==========================================
# 目录路径配置 (如需迁移环境，仅需修改此处)
# ==========================================
# 1. 宿主系统用户主目录
OCFS_SYSTEM_HOME=/home/node

# 2. OpenClaw 基础状态目录 (用于读取网关的配置和代理会话状态)
OPENCLAW_STATE_DIR=/home/node/.openclaw

# 3. OCFS 工作区归属目录 (代理文件操作的主工作中心)
OCFS_WORKSPACE_DIR=/home/node/.openclaw/workspace-ocfs

# 4. 用户文档存储中心 (文档或知识库的硬性最高限制目录)
OCFS_DOCS_DIR=/home/node/github/text

# 5. Playwright 缓存 Chromium 的目标目录 (供本地爬虫使用)
PLAYWRIGHT_CACHE_DIR=/home/node/.cache/ms-playwright

# 6. 宿主 Node 全局模块地址 (系统查找内置命令与执行插件时的查找路径)
GLOBAL_NODE_PATH=/home/node/.local/share/pnpm/global/5/node_modules

# 7. VCP 热插拔插件存储的外部目录
VCP_PLUGINS_DIR=/home/node/.codex/plugins

# ==========================================
# fetch相关设置
# ==========================================
# 代理端口（可选）
FETCH_PROXY_PORT=7890
# ===== Cookies 配置（三选一） =====

# 方式1：单站点原始格式（最简单，适合只访问一个网站）
# 直接粘贴从浏览器复制的 cookie 字符串
# 示例：SESSDATA=abc123; bili_jct=xyz789; DedeUserID=12345
# 注意：访问任何网站都会使用这些 cookies
FETCH_COOKIES_RAW=

# 方式2：多站点原始格式（推荐，支持多个网站）
# JSON 对象格式，key 是域名关键词，value 是 cookie 字符串
# 会根据访问的 URL 自动匹配对应的 cookies
# 示例：{"bilibili.com":"SESSDATA=abc123; bili_jct=xyz","twitter.com":"auth_token=xxx; ct0=yyy"}
FETCH_COOKIES_RAW_MULTI=

# 方式3：JSON 数组格式（高级用户，支持最多参数）
# 格式示例：[{"name":"session_id","value":"abc123","domain":".example.com"}]
# 完整参数示例：[{"name":"token","value":"xxx","domain":".example.com","path":"/","expires":-1,"httpOnly":false,"secure":true,"sameSite":"Lax"}]
FETCH_COOKIES=

# 优先级：FETCH_COOKIES_RAW_MULTI > FETCH_COOKIES_RAW > FETCH_COOKIES

# ==========================================
# Gsearch配置
# ==========================================
VSearchKey=your_api_key_here
VSearchUrl=http://127.0.0.1:3000/v1/models/
VSearchModel=gemini-2.5-flash-lite-preview-09-2025
VSearchMaxToken=8192
MaxConcurrent=5

# ==========================================
# 其他配置
# ==========================================

# OCFS 防抖时间（毫秒），大模型流式输出完毕后等待多久再执行。默认 1500
OCFS_DEBOUNCE_MS=1500
